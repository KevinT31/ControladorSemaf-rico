# Copy this file to .env and replace every placeholder before running auth-enabled mode.
# Generate SECRET_KEY, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

AUTH_ENABLED=true
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TOKEN_EXP_MIN=480

# Optional demo users. Leave a value empty to avoid creating that demo account.
DEMO_OPERATOR_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
DEMO_TECHNICIAN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
DEMO_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

DEBUG=false
