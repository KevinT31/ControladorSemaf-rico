# Copy this file to .env and replace every placeholder before running auth-enabled mode.
# Generate SECRET_KEY, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

AUTH_ENABLED=true
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TOKEN_EXP_MIN=480

# Optional demo users. Leave a value empty to avoid creating that demo account.
DEMO_OPERATOR_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
DEMO_TECHNICIAN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
DEMO_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD

DEBUG=false

# Clave de HERE Traffic API (opcional; solo capa de tráfico real del mapa)
# HERE_API_KEY=

# ── NSB: overrides del nodo (pisan config/nsb/node.yaml) ────────────────
# NSB_MODE=tsc_emulated
# NSB_NODE_ID=nsb-node-01
# NSB_HIL__HOST=127.0.0.1
# NSB_HIL__PORT=9500
# NSB_TELEMETRY__MQTT_ENABLED=false

# Tercera compuerta de AUTOMATED_DIRECT_LAB: debe valer exactamente el
# node_id del nodo que se quiere autorizar. Solo en la máquina local.
# NSB_CONFIRM_DIRECT_LAB=

# ── NSB: overrides del gateway (pisan config/nsb/gateway.yaml) ──────────
# NSB_GW_SEED=42
# NSB_GW_BIND_HOST=127.0.0.1
# NSB_GW_TIMEOUT_POLICY=fallback
