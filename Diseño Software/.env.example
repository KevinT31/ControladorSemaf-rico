# Variables de entorno del proyecto (COPIA a .env y completa; .env está en
# .gitignore — NUNCA commitear secretos reales).

# ── Backend FastAPI existente (servidor-backend/config.py) ──────────────
# Clave de firma JWT. Si se omite, el backend crea una clave efímera segura;
# defínela para que las sesiones sobrevivan reinicios o múltiples workers.
# SECRET_KEY=

# Credenciales iniciales opcionales. Si se omiten, el backend genera claves
# aleatorias en .demo_credentials.json (archivo local ignorado por Git).
# DEMO_OPERADOR_PASSWORD=
# DEMO_TECNICO_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# Clave de HERE Traffic API (opcional; solo capa de tráfico real del mapa)
# HERE_API_KEY=

# ── NSB: overrides del nodo (pisan config/nsb/node.yaml) ────────────────
# NSB_MODE=tsc_emulated
# NSB_NODE_ID=nsb-node-01
# NSB_HIL__HOST=127.0.0.1
# NSB_HIL__PORT=9500
# NSB_TELEMETRY__MQTT_ENABLED=false

# Tercera compuerta de AUTOMATED_DIRECT_LAB: debe valer exactamente el
# node_id del nodo que se quiere autorizar. Solo en la máquina local.
# NSB_CONFIRM_DIRECT_LAB=

# ── NSB: overrides del gateway (pisan config/nsb/gateway.yaml) ──────────
# NSB_GW_SEED=42
# NSB_GW_BIND_HOST=127.0.0.1
# NSB_GW_TIMEOUT_POLICY=fallback
