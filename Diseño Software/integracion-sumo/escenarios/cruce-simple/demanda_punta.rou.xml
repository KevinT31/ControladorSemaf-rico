<?xml version="1.0" encoding="UTF-8"?>
<!--
Demanda HORA PUNTA: perfil temporal NO estacionario y ASIMÉTRICO (pico en el
eje Norte-Sur a mitad de la simulación). Es el escenario más interesante para:
  - control adaptativo (la asimetría premia redistribuir el verde), y
  - predicción CNN-LSTM (hay estructura temporal que aprender).
Tramos: 0-600 valle | 600-1500 subida | 1500-2400 PICO NS | 2400-3000 bajada | 3000-3600 valle.
-->
<routes>
    <vType id="coche" accel="2.6" decel="4.5" length="5.0" minGap="2.5"
           maxSpeed="16.67" speedDev="0.10" sigma="0.5"/>

    <!-- ================== 0-600 s: valle ================== -->
    <flow id="ns_th_1" type="coche" begin="0" end="600" probability="0.08" from="N_C" to="C_S" departLane="best" departSpeed="max"/>
    <flow id="sn_th_1" type="coche" begin="0" end="600" probability="0.08" from="S_C" to="C_N" departLane="best" departSpeed="max"/>
    <flow id="ew_th_1" type="coche" begin="0" end="600" probability="0.08" from="E_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="we_th_1" type="coche" begin="0" end="600" probability="0.08" from="W_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="n_r_1" type="coche" begin="0" end="600" probability="0.02" from="N_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="s_r_1" type="coche" begin="0" end="600" probability="0.02" from="S_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="e_r_1" type="coche" begin="0" end="600" probability="0.02" from="E_C" to="C_N" departLane="best" departSpeed="max"/>
    <flow id="w_r_1" type="coche" begin="0" end="600" probability="0.02" from="W_C" to="C_S" departLane="best" departSpeed="max"/>

    <!-- ================== 600-1500 s: subida ================== -->
    <flow id="ns_th_2" type="coche" begin="600" end="1500" probability="0.16" from="N_C" to="C_S" departLane="best" departSpeed="max"/>
    <flow id="sn_th_2" type="coche" begin="600" end="1500" probability="0.14" from="S_C" to="C_N" departLane="best" departSpeed="max"/>
    <flow id="ew_th_2" type="coche" begin="600" end="1500" probability="0.10" from="E_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="we_th_2" type="coche" begin="600" end="1500" probability="0.10" from="W_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="n_r_2" type="coche" begin="600" end="1500" probability="0.03" from="N_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="s_r_2" type="coche" begin="600" end="1500" probability="0.03" from="S_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="e_r_2" type="coche" begin="600" end="1500" probability="0.02" from="E_C" to="C_N" departLane="best" departSpeed="max"/>
    <flow id="w_r_2" type="coche" begin="600" end="1500" probability="0.02" from="W_C" to="C_S" departLane="best" departSpeed="max"/>

    <!-- ================== 1500-2400 s: PICO Norte-Sur ================== -->
    <flow id="ns_th_3" type="coche" begin="1500" end="2400" probability="0.24" from="N_C" to="C_S" departLane="best" departSpeed="max"/>
    <flow id="sn_th_3" type="coche" begin="1500" end="2400" probability="0.20" from="S_C" to="C_N" departLane="best" departSpeed="max"/>
    <flow id="ew_th_3" type="coche" begin="1500" end="2400" probability="0.10" from="E_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="we_th_3" type="coche" begin="1500" end="2400" probability="0.10" from="W_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="n_r_3" type="coche" begin="1500" end="2400" probability="0.03" from="N_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="n_l_3" type="coche" begin="1500" end="2400" probability="0.02" from="N_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="s_r_3" type="coche" begin="1500" end="2400" probability="0.03" from="S_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="e_r_3" type="coche" begin="1500" end="2400" probability="0.02" from="E_C" to="C_N" departLane="best" departSpeed="max"/>
    <flow id="w_r_3" type="coche" begin="1500" end="2400" probability="0.02" from="W_C" to="C_S" departLane="best" departSpeed="max"/>

    <!-- ================== 2400-3000 s: bajada ================== -->
    <flow id="ns_th_4" type="coche" begin="2400" end="3000" probability="0.14" from="N_C" to="C_S" departLane="best" departSpeed="max"/>
    <flow id="sn_th_4" type="coche" begin="2400" end="3000" probability="0.12" from="S_C" to="C_N" departLane="best" departSpeed="max"/>
    <flow id="ew_th_4" type="coche" begin="2400" end="3000" probability="0.09" from="E_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="we_th_4" type="coche" begin="2400" end="3000" probability="0.09" from="W_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="n_r_4" type="coche" begin="2400" end="3000" probability="0.02" from="N_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="s_r_4" type="coche" begin="2400" end="3000" probability="0.02" from="S_C" to="C_E" departLane="best" departSpeed="max"/>

    <!-- ================== 3000-3600 s: valle ================== -->
    <flow id="ns_th_5" type="coche" begin="3000" end="3600" probability="0.07" from="N_C" to="C_S" departLane="best" departSpeed="max"/>
    <flow id="sn_th_5" type="coche" begin="3000" end="3600" probability="0.07" from="S_C" to="C_N" departLane="best" departSpeed="max"/>
    <flow id="ew_th_5" type="coche" begin="3000" end="3600" probability="0.07" from="E_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="we_th_5" type="coche" begin="3000" end="3600" probability="0.07" from="W_C" to="C_E" departLane="best" departSpeed="max"/>
    <flow id="n_r_5" type="coche" begin="3000" end="3600" probability="0.02" from="N_C" to="C_W" departLane="best" departSpeed="max"/>
    <flow id="s_r_5" type="coche" begin="3000" end="3600" probability="0.02" from="S_C" to="C_E" departLane="best" departSpeed="max"/>
</routes>
